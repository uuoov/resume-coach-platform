# API 配置
# DeepSeek API 配置（默认推荐）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 可选：通义千问 API 配置 (阿里云百炼)
# DASHSCOPE_API_KEY=your_dashscope_api_key_here
# DASHSCOPE_MODEL=qwen-plus

# 或者使用其他 AI 提供商
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# 数据库配置 (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/resume_coach?schema=public"

# 服务器配置
PORT=3001
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGIN=http://localhost:5173
WEB_HTTP_PORT=8080

# 仅限本地无数据库调试时开启；生产环境不要开启
# AUTH_MEMORY_FALLBACK=false

# 文件存储配置 (本地或对象存储)
FILE_STORAGE_PATH=./uploads
# 或使用 OSS
# OSS_ACCESS_KEY_ID=your_access_key_id
# OSS_ACCESS_KEY_SECRET=your_access_key_secret
# OSS_BUCKET=your_bucket_name
# OSS_REGION=oss-cn-shanghai

# Redis 缓存（可选，不配置时所有缓存操作退化为 no-op）
# REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# 安全配置
BCRYPT_ROUNDS=12

# Admin 后台超管引导：逗号分隔的 email 列表
# 配置后，登录命中该列表的账号会自动升级为 ADMIN 角色
# 空值时无超管；内存测试账号 admin@example.com 始终为 ADMIN，作为应急入口
# SUPER_ADMIN_EMAILS=admin@example.com,ops@your-domain.com

# 日志（可选）
# LOG_LEVEL=info
# LOG_FILE_PATH=./logs
